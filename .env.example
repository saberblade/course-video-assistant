# 复制为 .env.local 后按需填写；.env.local 不入库。
# 本文件不写任何真实密钥。

APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db

# FFmpeg：留空则用 PATH 里的可执行文件；也可写成 tools/ffmpeg/ffmpeg.exe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# 转写模型目录（需自备，见 deploy/02_模型准备说明.md）
WHISPER_MODEL_DIR=./models/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh

MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_SECONDS=1200
MAX_UNFINISHED_JOBS=3
TRANSCRIBE_CONCURRENCY=1
TASK_TIMEOUT_SECONDS=1200
# 启动预热占锁时，转写任务最多等待多少秒（不是失败）
TRANSCRIBE_LOCK_WAIT_SECONDS=180
QUESTION_CONCURRENCY=1

RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARACTERS=6000

# 生成与向量共用同一套百炼账号；不填则问答降级为「只给课程原文」，功能仍可用。
# 示例（阿里云百炼）：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_TOTAL_DEADLINE_SECONDS=25
ANSWER_MODE=generative

# RAG 检索（可选，不填即用下列默认值）
# RAG_INDEXING_ENABLED=1        # 留空时：向量接口配好就自动建索引
# RAG_RETRIEVAL_MODE=hybrid     # hybrid=BM25+向量RRF；bm25=只看关键词（基线对照）
# RAG_EMBEDDING_BASE_URL=       # 留空回落到 LLM_BASE_URL
# RAG_EMBEDDING_API_KEY=        # 留空回落到 LLM_API_KEY
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
# RAG_EMBEDDING_BATCH_SIZE=10
# RAG_EMBEDDING_CONNECT_TIMEOUT=5
# RAG_INDEX_BUDGET_SECONDS=300
# RAG_INDEX_IDLE_SECONDS=1.0
